@{
    var rawUserName = Context.Request.Cookies["UserName"];
    var currentUserName = !string.IsNullOrWhiteSpace(rawUserName) 
        ? System.Net.WebUtility.UrlDecode(rawUserName) 
        : "Quản Trị Viên";

    var avatarInitial = !string.IsNullOrWhiteSpace(currentUserName) 
        ? currentUserName.Trim().Substring(0, 1).ToUpper() 
        : "A";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Trị Hệ Thống</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

    <!-- SIDEBAR ADMIN -->
    <aside id="dashSidebar" class="dash-sidebar">
        <div>
            <div class="sidebar-header">
                <a href="/Admin/Campaigns" class="sidebar-brand">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="#ef4444">
                        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                    </svg>
                    <div>
                        <div class="brand-title">Ban Tổ Chức</div>
                    </div>
                </a>
            </div>

            <!-- MENU ADMIN (2 MENU CHÍNH) -->
            <ul class="sidebar-menu">
                <!-- Menu 1: Quản lý Campaigns -->
                <li class="sidebar-item">
                    <a href="/Admin/Campaigns" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Campaigns" ? "active" : "")">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Quản lý chiến dịch</span>
                    </a>
                </li>

                <!-- Menu 2: Quản lý User -->
                <li class="sidebar-item">
                    <a href="/Admin/Users" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Users" ? "active" : "")">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                        <span>Quản lý User</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-footer">
            <a href="/Auth/Logout" class="btn-logout" title="Đăng xuất khỏi hệ thống">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- MAIN AREA -->
    <div class="dash-main">
        <!-- TOPBAR -->
        <header class="dash-topbar">
            <div class="topbar-left">
                <button type="button" id="btnMenuToggle" class="btn-menu-toggle" onclick="toggleSidebar()">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>

            <div class="topbar-right">
                <div class="user-profile-widget">
                    <div class="user-avatar">@avatarInitial</div>
                    <div class="user-info-text d-none d-sm-block">
                        <div class="user-role-label">Welcome to!</div>
                        <div class="user-name">@currentUserName</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <main class="dash-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

