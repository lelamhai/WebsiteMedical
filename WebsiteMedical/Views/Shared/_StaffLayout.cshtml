@{
    var rawUserName = Context.Request.Cookies["UserName"];
    var currentUserName = !string.IsNullOrWhiteSpace(rawUserName) 
        ? System.Net.WebUtility.UrlDecode(rawUserName) 
        : "Bác sĩ Trực ban";

    var avatarInitial = !string.IsNullOrWhiteSpace(currentUserName) 
        ? (currentUserName.Length >= 2 && currentUserName.Contains(" ") 
            ? string.Concat(currentUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(s => s[0])).ToUpper() 
            : currentUserName.Trim().Substring(0, 1).ToUpper()) 
        : "BS";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
</head>
<body class="dashboard-body">

    <!-- SIDEBAR STAFF -->
    <aside id="dashSidebar" class="dash-sidebar">
        <div>
            <div class="sidebar-header">
                <a href="/Staff/DutySchedule" class="sidebar-brand">
                    <svg viewBox="0 0 24 24" width="28" height="28" fill="#3b82f6">
                        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                    </svg>
                    <div>
                        <div class="brand-title">Cán Bộ Y Tế</div>
                    </div>
                </a>
            </div>

            <!-- MENU STAFF (3 MENU CHÍNH) -->
            <ul class="sidebar-menu">
                <li class="menu-label">Nghiệp vụ Y tế</li>
                
                <!-- Menu 1: Xem phân công trực của Campaigns -->
                <li class="sidebar-item">
                    <a href="/Staff/DutySchedule" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "DutySchedule" ? "active" : "")">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Phân công lịch trực</span>
                    </a>
                </li>

                <!-- Menu Mới: Tạo hồ sơ khám -->
                <li class="sidebar-item">
                    <a href="/Staff/CreateRecord" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CreateRecord" ? "active" : "")">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                        </svg>
                        <span>Tạo hồ sơ khám</span>
                    </a>
                </li>

                <!-- Menu 2: Quản lý hồ sơ khám -->
                <li class="sidebar-item">
                    <a href="/Staff/MedicalRecords" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MedicalRecords" ? "active" : "")">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                        <span>Quản lý hồ sơ khám</span>
                    </a>
                </li>

                <!-- Menu 3: Tiếp nhận & Check-in QR -->
                <li class="sidebar-item">
                    <a href="/Staff/CheckIn" class="sidebar-link @(ViewContext.RouteData.Values["action"]?.ToString() == "CheckIn" ? "active" : "")">
                        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <rect x="3" y="3" width="7" height="7"></rect>
                            <rect x="14" y="3" width="7" height="7"></rect>
                            <rect x="14" y="14" width="7" height="7"></rect>
                            <rect x="3" y="14" width="7" height="7"></rect>
                        </svg>
                        <span>Tiếp nhận & Check-in</span>
                    </a>
                </li>
            </ul>
        </div>

        <div class="sidebar-footer">
            <a href="/Auth/Logout" class="btn-logout" title="Đăng xuất khỏi hệ thống">
                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>Đăng xuất</span>
            </a>
        </div>
    </aside>

    <!-- MAIN AREA -->
    <div class="dash-main">
        <!-- TOPBAR -->
        <header class="dash-topbar">
            <div class="topbar-left">
                <button type="button" id="btnMenuToggle" class="btn-menu-toggle" onclick="toggleSidebar()">
                    <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <line x1="3" y1="12" x2="21" y2="12"></line>
                        <line x1="3" y1="6" x2="21" y2="6"></line>
                        <line x1="3" y1="18" x2="21" y2="18"></line>
                    </svg>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>

            <div class="topbar-right">
                <div class="user-profile-widget">
                    <div class="user-avatar" style="background:#dbeafe; color:#2563eb; border-color:#bfdbfe;">@avatarInitial</div>
                    <div class="user-info-text d-none d-sm-block">
                        <div class="user-role-label">Welcome to!</div>
                        <div class="user-name">@currentUserName</div>
                    </div>
                </div>
            </div>
        </header>

        <!-- CONTENT -->
        <main class="dash-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

