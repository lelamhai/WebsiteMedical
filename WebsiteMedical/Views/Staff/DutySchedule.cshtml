@model WebsiteMedical.Models.StaffScheduleViewModel

@{
	Layout = "_StaffLayout";
	ViewData["Title"] = "Phân Công Lịch Trực";

	var today = DateTime.Today;
	var upcomingCount = Model.Schedules.Count(schedule => schedule.EventDate.Date >= today);
	var todayCount = Model.Schedules.Count(schedule => schedule.EventDate.Date == today);
	var firstItem = Model.TotalItems == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
	var lastItem = Math.Min(Model.Page * Model.PageSize, Model.TotalItems);
}

<div class="content-card">
	<div class="content-card-header">
		<div>
			<h2 class="card-heading">Danh Sách Lịch Trực</h2>
		</div>
	</div>

	@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
	{
		<div class="schedule-message schedule-message-error" role="alert">
			<strong>Không tải được lịch trực.</strong>
			<span>@Model.ErrorMessage</span>
			<a class="btn btn-sm btn-outline-danger" href="@Context.Request.Path">Thử lại</a>
		</div>
	}
	else if (Model.Schedules.Count == 0)
	{
		<div class="schedule-message">
			<strong>Chưa có lịch trực</strong>
			<span>Hiện chưa có chiến dịch nào được phân công cho bạn.</span>
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-custom table-hover schedule-table mb-0">
				<thead>
					<tr>
						<th class="text-end" style="text-align: left !important;">Mã cd</th>
						<th>Chiến dịch</th>
						<th>Ngày và giờ sự kiện</th>
						<th>Ca trực</th>
						<th>Địa điểm</th>
						<th>Trạng thái</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var schedule in Model.Schedules.OrderBy(item => item.EventDate))
					{
						var isToday = schedule.EventDate.Date == today;
						var isCompleted = schedule.EventDate.Date < today;
						var statusText = isToday ? "Đang diễn ra" : isCompleted ? "Đã hoàn thành" : "Sắp diễn ra";
						var statusClass = isToday ? "badge-active" : isCompleted ? "badge-ended" : "badge-upcoming";
						<tr class="@(isToday ? "schedule-today" : null)">
							<td><span class="badge bg-secondary-subtle text-dark border fw-bold">#@schedule.CampaignId</span></td>
							<td>
								<strong class="schedule-title">@schedule.Title</strong>
							</td>
							<td>
								<strong>@schedule.EventDate.ToString("dd/MM/yyyy")</strong>
								<span class="text-muted d-block small">@schedule.EventDate.ToString("HH:mm")</span>
							</td>
							<td><span class="shift-badge">@schedule.ShiftTime</span></td>
							<td><span class="location-text">@schedule.Location</span></td>
							<td><span class="badge-status @statusClass">@statusText</span></td>
						</tr>
					}
				</tbody>
			</table>
		</div>

		<div class="schedule-pagination">
			<div class="text-muted small"></div>

			@if (Model.TotalPages > 1)
			{
				<nav aria-label="Phân trang lịch trực">
					<ul class="pagination pagination-sm mb-0">
						<li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
							<a class="page-link" href="/Staff/DutySchedule?page=@(Model.Page - 1)" aria-label="Trang trước">&laquo; Trước</a>
						</li>

						@for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
						{
							<li class="page-item @(pageNumber == Model.Page ? "active" : "")">
								<a class="page-link" href="/Staff/DutySchedule?page=@pageNumber">@pageNumber</a>
							</li>
						}

						<li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
							<a class="page-link" href="/Staff/DutySchedule?page=@(Model.Page + 1)" aria-label="Trang sau">Sau &raquo;</a>
						</li>
					</ul>
				</nav>
			}
		</div>
	}
</div>