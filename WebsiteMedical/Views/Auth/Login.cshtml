@model WebsiteMedical.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - Hệ Thống Quản Lý Hiến Máu";
    bool isSuccess = Model?.IsSuccess ?? false;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Phông chữ & Bootstrap -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- File CSS riêng biệt -->
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>

    <div class="auth-container">
        <div class="auth-card">
            
            <!-- Cột trái: Cổng thông tin Hiến máu Nhân đạo -->
            <div class="auth-banner">
                <div>
                    <a href="/" class="brand-badge">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor">
                            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
                        </svg>
                        <div>
                            <div style="font-size: 1.15rem; font-weight: 700; line-height: 1.2;">HIẾN MÁU NHÂN ĐẠO</div>
                            <div style="font-size: 0.72rem; font-weight: 500; opacity: 0.85; letter-spacing: 0.5px;">CỔNG THÔNG TIN TÌNH NGUYỆN</div>
                        </div>
                    </a>

                    <div class="banner-slogan">
                        <h2>Mỗi giọt máu cho đi<br/>Một cuộc đời ở lại</h2>
                        <p>Hiến máu nhân đạo là nghĩa cử cao đẹp vì cộng đồng. Hãy cùng ngành y tế tiếp thêm sự sống cho hàng ngàn bệnh nhân cần máu mỗi ngày.</p>
                    </div>

                    <ul class="banner-features">
                        <li>
                            <div class="feature-icon-box">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                            </div>
                            <div>
                                <span class="feature-title">Đăng ký & Chọn lịch hẹn thuận tiện</span>
                                <div class="feature-desc">Chủ động chọn ngày, giờ và điểm hiến máu gần nhất để tránh phải chờ đợi lâu.</div>
                            </div>
                        </li>
                        <li>
                            <div class="feature-icon-box">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
                                </svg>
                            </div>
                            <div>
                                <span class="feature-title">Khám sàng lọc & Xét nghiệm máu an toàn</span>
                                <div class="feature-desc">Được bác sĩ thăm khám sức khỏe, đo huyết áp và kiểm tra nhóm máu miễn phí.</div>
                            </div>
                        </li>
                        <li>
                            <div class="feature-icon-box">
                                <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                            </div>
                            <div>
                                <span class="feature-title">Hồ sơ điện tử & Giấy chứng nhận hiến máu</span>
                                <div class="feature-desc">Theo dõi lịch sử hiến máu trọn đời và cấp giấy chứng nhận hiến máu tình nguyện.</div>
                            </div>
                        </li>
                    </ul>
                </div>

                <div class="banner-footer">
                    <div>Tổng đài hiến máu khẩn cấp: <strong>1900 6868</strong> (24/7)</div>
                    <div style="font-size: 0.78rem; opacity: 0.82; margin-top: 3px;">Tiếp nhận hiến máu & Điều phối ngân hàng máu cứu người</div>
                </div>
            </div>

            <!-- Cột phải: Form đăng nhập MVC & Hiển thị kết quả -->
            <div class="auth-form-wrapper">
                
                @if (!isSuccess)
                {
                    <!-- Thông báo lỗi từ Controller -->
                    @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
                    {
                        <div class="alert-custom alert-danger-custom">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24" class="flex-shrink-0 mt-1">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                            </svg>
                            <span>@Html.Raw(Model.ErrorMessage)</span>
                        </div>
                    }

                    <div class="auth-header">
                        <h1>Đăng nhập</h1>
                        <p>Nhập email và mật khẩu của bạn để truy cập hệ thống</p>
                    </div>

                    <!-- FORM ĐĂNG NHẬP -->
                    <form method="post" action="/" id="loginForm" onsubmit="onFormSubmit()">
                        @Html.AntiForgeryToken()

                        <!-- Email input -->
                        <div class="form-group">
                            <label class="form-label" asp-for="Email">Địa chỉ Email</label>
                            <div class="input-group-custom">
                                <span class="input-icon-left">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
                                    </svg>
                                </span>
                                <input asp-for="Email" type="email" id="email" required 
                                       placeholder="example@gmail.com" 
                                       autocomplete="email" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="validation-msg"></span>
                        </div>

                        <!-- Mật khẩu input -->
                        <div class="form-group">
                            <label class="form-label" asp-for="Password">Mật khẩu</label>
                            <div class="input-group-custom">
                                <span class="input-icon-left">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/>
                                    </svg>
                                </span>
                                <input asp-for="Password" type="password" id="password" required 
                                       placeholder="Nhập mật khẩu của bạn" 
                                       autocomplete="current-password" />
                                <button type="button" class="input-toggle-pwd" onclick="togglePasswordVisibility()" title="Ẩn/Hiện mật khẩu">
                                    <svg id="eyeIcon" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="validation-msg"></span>
                        </div>

                        <!-- Ghi nhớ phiên & Quên mật khẩu -->
                        <div class="form-extra">
                            <label class="form-check d-flex align-items-center gap-2 mb-0">
                                <input class="form-check-input" type="checkbox" asp-for="RememberMe" id="rememberMe">
                                <span class="form-check-label">Ghi nhớ đăng nhập</span>
                            </label>
                            <a href="#" class="forgot-link" onclick="alert('Vui lòng liên hệ ban tổ chức để hỗ trợ cấp lại mật khẩu.'); return false;">Quên mật khẩu?</a>
                        </div>

                        <!-- Nút Submit gửi về Controller -->
                        <button type="submit" id="submitBtn" class="btn-submit">
                            <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            <span id="btnText">Đăng nhập</span>
                            <svg id="btnArrowIcon" width="16" height="16" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-8.29-1.42 1.42L16.86 11H5v2z"/>
                            </svg>
                        </button>
                    </form>

                    <div class="auth-footer">
                        <span>Chưa có tài khoản? </span>
                        <a href="#" onclick="alert('Tình nguyện viên đăng ký tại ngày hội hiến máu hoặc liên hệ cán bộ y tế.'); return false;">Đăng ký</a>
                    </div>

                    <!-- Lối tắt xem trước các giao diện theo 3 Role -->
                    <div class="mt-4 pt-3 border-top text-center" style="font-size: 0.8rem; color: #64748b;">
                        <span class="d-block mb-2 text-muted fw-semibold">Xem trước giao diện theo vai trò (Role):</span>
                        <div class="d-flex justify-content-center flex-wrap gap-2">
                            <a href="/Admin/Campaigns" class="badge bg-danger-subtle text-danger border border-danger-subtle text-decoration-none py-1 px-2">👑 Admin (2 menu)</a>
                            <a href="/Staff/DutySchedule" class="badge bg-primary-subtle text-primary border border-primary-subtle text-decoration-none py-1 px-2">🩺 Staff (3 menu)</a>
                            <a href="/Auth/AccessDenied" class="badge bg-secondary-subtle text-dark border text-decoration-none py-1 px-2">🚫 Volunteer (Chặn quyền)</a>
                        </div>
                    </div>
                }
                else
                {
                    <!-- PHẦN HIỂN THỊ KẾT QUẢ KHI CONTROLLER GỌI API THÀNH CÔNG (GIỐNG TRONG HÌNH) -->
                    <div>
                        <div class="auth-header mb-3">
                            <div class="d-flex align-items-center gap-2">
                                <span style="display:inline-flex; width:28px; height:28px; background:#dcfce7; border-radius:50%; align-items:center; justify-content:center; color:#166534;">
                                    <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                                </span>
                                <h2 style="font-size: 1.35rem; font-weight:700; margin:0; color:#166534;">Đăng nhập thành công</h2>
                            </div>
                            <p class="text-muted mt-1" style="font-size:0.88rem;">Controller đã gọi API thành công và nhận JWT Token.</p>
                        </div>

                        <!-- Tóm tắt thông tin tài khoản giải mã từ Token trong Controller -->
                        <div class="user-quick-info">
                            <div class="quick-info-item">
                                <span>Email:</span>
                                <strong>@(Model?.UserEmail ?? Model?.Email)</strong>
                            </div>
                            <div class="quick-info-item">
                                <span>Vai trò:</span>
                                <span class="quick-info-badge">@(Model?.UserRole ?? "Admin")</span>
                            </div>
                            <div class="quick-info-item">
                                <span>Hết hạn:</span>
                                <span class="text-muted">@(Model?.UserExpires ?? "20/11/2026")</span>
                            </div>
                        </div>

                        <!-- Khung code JSON hiển thị đúng y như ảnh người dùng gửi -->
                        <div class="json-viewer-card">
                            <pre id="jsonViewer" class="json-content" 
                                 data-access-token="@Model?.ResponseData?.Data?.AccessToken" 
                                 data-refresh-token="@Model?.ResponseData?.Data?.RefreshToken" 
                                 data-expires="@Model?.ResponseData?.Data?.RefreshExpiresAt"
                                 data-user-name="@(Model?.UserFullName ?? Model?.UserEmail)"
                                 data-user-role="@Model?.UserRole">@Html.Raw(Model?.FormattedJson)</pre>
                            
                            <div class="json-actions">
                                <button type="button" class="btn-json-action" onclick="copyJsonToClipboard()" title="Sao chép toàn bộ JSON">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M8 4v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V7.242a2 2 0 0 0-.602-1.43L16.083 2.57A2 2 0 0 0 14.685 2H10a2 2 0 0 0-2 2z"></path>
                                        <path d="M16 18v2a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h2"></path>
                                    </svg>
                                    <span>Copy JSON</span>
                                </button>

                                <button type="button" class="btn-json-action" onclick="copyTokenOnly()" title="Sao chép chỉ Access Token">
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 24 24">
                                        <path d="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
                                    </svg>
                                    <span>Copy Token</span>
                                </button>

                                <button type="button" class="btn-json-action btn-download-primary" onclick="downloadJsonResponse()" title="Tải file JSON về máy (như nút Download trong ảnh)">
                                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                        <polyline points="7 10 12 15 17 10"></polyline>
                                        <line x1="12" y1="15" x2="12" y2="3"></line>
                                    </svg>
                                    <span>Download</span>
                                </button>
                            </div>
                        </div>

                        <!-- Các nút điều hướng sau khi đăng nhập thành công -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-2">
                            <a href="/" class="btn-reset-auth">
                                &larr; Đăng nhập lại
                            </a>
                            <a href="/" class="btn-submit" style="width: auto; padding: 8px 18px; font-size: 0.88rem; text-decoration: none;">
                                Vào trang chủ hệ thống
                            </a>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- Toast thông báo đã copy -->
    <div id="toastCopy" class="toast-copy">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
        <span id="toastCopyText">Đã sao chép!</span>
    </div>

    <!-- File JS riêng biệt -->
    <script src="~/js/login.js" asp-append-version="true"></script>
</body>
</html>
