@model WebsiteMedical.Models.CampaignListViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý chiến dịch";
}

<!-- BẢNG DANH SÁCH CHIẾN DỊCH -->
<div class="content-card mb-4">
    <div class="content-card-header">
        <div class="d-flex align-items-center gap-3">
            <h2 class="card-heading">Danh sách Chiến dịch</h2>
            <span class="badge bg-light text-dark border">@Model.PagedData.TotalItems chiến dịch</span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width: 240px;">
                <input type="text" id="campaignSearchInput" class="form-control" placeholder="Tìm kiếm chiến dịch..." onkeyup="filterCampaignTable()">
            </div>
            <button type="button" class="btn btn-danger btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#createCampaignModal">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/></svg>
                <span>Tạo chiến dịch mới</span>
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-custom table-hover mb-0" id="campaignTable">
            <thead>
                <tr>
                    <th style="width: 90px;">Mã CD</th>
                    <th>Tên chiến dịch</th>
                    <th>Địa điểm</th>
                    <th>Thời gian</th>
                    <th>Nhân sự</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.PagedData.Items != null && Model.PagedData.Items.Any())
                {
                    foreach (var item in Model.PagedData.Items)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-secondary-subtle text-dark border fw-bold">#@item.CampaignId</span>
                            </td>
                            <td>
                                <strong class="text-dark d-block">@item.Title</strong>
                            </td>
                            <td>
                                <span class="text-dark">@item.Location</span>
                            </td>
                            <td>
                                <div class="text-nowrap">@item.FormattedEventDate</div>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                                    &#128101; @item.StaffCount Cán bộ
                                </span>
                            </td>
                            <td>
                                <span class="badge-status @item.StatusBadgeClass">@item.StatusText</span>
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-outline-secondary btn-sm" title="Chỉnh sửa">&#9998;</button>
                                <button class="btn btn-outline-primary btn-sm" title="Phân công nhân sự">&#128101;</button>
                                <button class="btn btn-outline-danger btn-sm" title="Xem chi tiết">&#128065;</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <div class="mb-2" style="font-size: 2rem;">&#128203;</div>
                            <div class="fw-semibold">Không tìm thấy chiến dịch nào trong hệ thống</div>
                            <p class="small text-secondary mb-0">Vui lòng kiểm tra lại số trang hoặc tạo mới chiến dịch.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- PHÂN TRANG (PAGINATION) -->
    <div class="p-3 border-top d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="text-muted small"></div>

        @if (Model.PagedData.TotalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <!-- Nút Trang trước -->
                    <li class="page-item @(Model.PagedData.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/Admin/Campaigns?page=@(Model.PagedData.Page - 1)" aria-label="Previous">
                            &laquo; Trước
                        </a>
                    </li>

                    <!-- Danh sách các số trang -->
                    @for (int p = 1; p <= Model.PagedData.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PagedData.Page ? "active" : "")">
                            <a class="page-link" href="/Admin/Campaigns?page=@p">@p</a>
                        </li>
                    }

                    <!-- Nút Trang sau -->
                    <li class="page-item @(Model.PagedData.Page >= Model.PagedData.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/Admin/Campaigns?page=@(Model.PagedData.Page + 1)" aria-label="Next">
                            Sau &raquo;
                        </a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<!-- MODAL TẠO CHIẾN DỊCH MỚI -->
<div class="modal fade" id="createCampaignModal" tabindex="-1" aria-labelledby="createCampaignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="createCampaignModalLabel">Tạo Chiến Dịch Hiến Máu Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formCreateCampaign">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold">Tên chương trình / Chiến dịch <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Ví dụ: Chiến dịch hiến máu tình nguyện PTIT 2026" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Thời gian tổ chức <span class="text-danger">*</span></label>
                            <input type="datetime-local" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số lượng Cán bộ y tế dự kiến</label>
                            <input type="number" class="form-control" placeholder="Ví dụ: 3" min="1" value="3">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Địa điểm tổ chức <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Ví dụ: Hội trường A, Học viện PTIT" required>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-danger" onclick="alert('Đã lưu chiến dịch mới thành công!');" data-bs-dismiss="modal">Xác nhận tạo chiến dịch</button>
            </div>
        </div>
    </div>
</div>

<script>
    function filterCampaignTable() {
        const input = document.getElementById('campaignSearchInput');
        const filter = input.value.toLowerCase();
        const table = document.getElementById('campaignTable');
        const trs = table.getElementsByTagName('tr');

        for (let i = 1; i < trs.length; i++) {
            const rowText = trs[i].innerText.toLowerCase();
            trs[i].style.display = rowText.includes(filter) ? '' : 'none';
        }
    }
</script>
